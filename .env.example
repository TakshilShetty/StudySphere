# ───────────────────────── StudySphere configuration ─────────────────────────
# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

NODE_ENV=development
PORT=5000

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/studysphere
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studysphere
MONGO_URI=mongodb://127.0.0.1:27017/studysphere

# Secret used to sign login tokens (JWT). Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_string_here
JWT_EXPIRES_IN=7d

# Only needed if the frontend is served from a DIFFERENT origin than this API
# (e.g. VS Code Live Server on http://127.0.0.1:5500). Comma-separated list.
# Leave empty when the frontend is served by this Express server (recommended).
CORS_ORIGIN=

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx...) so
# rate limiting sees real client IPs.
TRUST_PROXY=

# ── File uploads ──
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ── Moderation / behaviour ──
# true  = new student uploads stay "pending" until an admin approves them
# false = uploads are published immediately (admins can still remove them)
REQUIRE_APPROVAL=false
# true = downloads/previews need a logged-in user (frontend then uses fetch+blob)
REQUIRE_LOGIN_FOR_DOWNLOAD=false
# A resource is auto-hidden for review after this many reports from different users
REPORT_AUTO_HIDE_THRESHOLD=5
# Ranking: assumed average rating for resources with no reviews (Bayesian prior)
RANKING_PRIOR_MEAN=3.5

# ── Seed script only (npm run seed / npm run seed:admin) ──
ADMIN_NAME=StudySphere Admin
ADMIN_EMAIL=admin@studysphere.test
ADMIN_PASSWORD=Admin@12345
